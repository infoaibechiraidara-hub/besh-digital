# BESH DIGITAL Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# Application Settings
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
APP_URL=http://localhost:5000

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=sqlite:///besh-digital/database/app.db

# ===========================================
# Security
# ===========================================
SECRET_KEY=your-very-secret-key-change-me-in-production
JWT_SECRET=your-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# Payment Providers - CinetPay
# ===========================================
# Get your keys from: https://www.cinetpay.com/
CID_MALL=https://api-cinetpay.cipay-lean.com
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id
CINETPAY_TRANSACTION_KEY=your-cinetpay-transaction-key
CINETPAY_WAN_ENV=1  # 1=Test, 2=Production

# ===========================================
# Payment Providers - Flutterwave
# ===========================================
# Get your keys from: https://dashboard.flutterwave.com/
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=FLWECRK_TEST-xxxxxxxxxxxxxxx
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# ===========================================
# Payment - Paystack (for Nigeria, Ghana, etc.)
# ===========================================
# Get your keys from: https://dashboard.paystack.com/
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ===========================================
# Email Configuration
# ===========================================
# SMTP settings for transactional emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@beshdigital.com
SMTP_FROM_NAME=BESH DIGITAL

# ===========================================
# Cloud Storage (Optional)
# ===========================================
# For storing product files
UPLOAD_DIR=uploads
MAX_FILE_SIZE=104857600  # 100MB in bytes

# Cloud storage (optional)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ===========================================
# Application Features
# ===========================================
MAX_DOWNLOADS=3
DOWNLOAD_EXPIRY_DAYS=7
MAX_FILE_UPLOAD_SIZE=100MB

# ===========================================
# Admin Settings
# ===========================================
ADMIN_EMAIL=admin@beshdigital.com
ADMIN_PASSWORD=admin-password-change-me

# ===========================================
# External APIs
# ===========================================
# Google Analytics / Meta Pixels (configured separately)
# META_PIXEL_ID=your-pixel-id
# GA_MEASUREMENT_ID=your-ga-id

# ===========================================
# Supabase Configuration (Free tier)
# ===========================================
# Get your keys from: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Payment Providers - PayPal
# ===========================================
# Get your keys from: https://developer.paypal.com/
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ===========================================
# Email Configuration (Resend - Free 100 emails/day)
# ===========================================
RESEND_API_KEY=your-resend-api-key

# ===========================================
# Authentication
# ===========================================
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# Environment
# ===========================================
NODE_ENV=development
DEBUG=true